YOYOO_DOMAIN=app.yoyooai.com
YOYOO_IMAGE=yoyoo-space:replace-with-release-commit
YOYOO_HUMAN_AUTH_MODE=aicard
YOYOO_LOCAL_OWNER_ID=local-owner-ui
YOYOO_AGENT_ADAPTER=deterministic-test
YOYOO_BUILTIN_AGENTS=none
YOYOO_AICARD_ISSUER=https://id.yoyooai.com
YOYOO_AICARD_CLIENT_ID=yoyoo_prod
YOYOO_AICARD_AUDIENCE=yoyoo
YOYOO_AICARD_REDIRECT_URI=https://app.yoyooai.com/auth/aicard/callback

# Generate each value on the production host. Do not commit the generated file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Required only for an explicitly approved rollback to password mode.
YOYOO_AUTH_PEPPER=replace-with-32-random-base64url-bytes
YOYOO_AICARD_SESSION_SECRET=replace-with-32-random-base64url-bytes
