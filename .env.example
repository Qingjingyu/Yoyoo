# Local PostgreSQL started by `npm run db:up`.
DATABASE_URL=postgresql://yoyoo:yoyoo_dev@127.0.0.1:55432/yoyoo_space

# Integration tests default to the same isolated local development database.
TEST_DATABASE_URL=postgresql://yoyoo:yoyoo_dev@127.0.0.1:55432/yoyoo_space

# One private local owner. Authentication replaces this before public deployment.
YOYOO_LOCAL_OWNER_ID=local-owner-ui

# Public human login. Keep password mode disabled for ordinary localhost work.
# Production must use the exact HTTPS origin and a private 32-byte base64url pepper.
# YOYOO_HUMAN_AUTH_MODE=password
# YOYOO_PUBLIC_ORIGIN=https://app.yoyooai.com
# YOYOO_AUTH_PEPPER=replace_with_32_random_base64url_bytes

# Keeps the deterministic development Agent slow enough to exercise Stop.
YOYOO_TEST_AGENT_DELAY_MS=600

# Optional local-only failure injection for visible Reviewer retry acceptance.
# YOYOO_DEMO_REVIEWER_FAILURE_PATTERN=可恢复的失败

# Default `npm run dev` uses local Planner, Builder, and Reviewer Agents.
# `npm run dev:yos` uses real Codex, local Builder, and real YOS.
# The wrapper reads the existing local `~/yos/.env` file in the server process.
YOYOO_AGENT_ADAPTER=deterministic-test

# AI Card Phase 6A identity authorization. The callback is pre-registered by
# AI Card and must stay byte-for-byte identical in local development.
YOYOO_AICARD_ISSUER=http://localhost:3000
YOYOO_AICARD_CLIENT_ID=yoyoo_dev
YOYOO_AICARD_AUDIENCE=yoyoo
YOYOO_AICARD_REDIRECT_URI=http://localhost:4173/auth/aicard/callback
# Generate a private 32-byte base64url value; never commit the generated value.
# YOYOO_AICARD_SESSION_SECRET=replace_with_32_byte_base64url_secret

# Codex mode uses the locally authenticated Codex CLI and never forwards the
# Yoyoo database, YOS password, or OPENAI_API_KEY into the child process.
# YOYOO_CODEX_COMMAND=/absolute/path/to/codex
YOYOO_CODEX_TIMEOUT_MS=180000

# Optional explicit YOS Web Console connection. When URL is omitted, YOS mode
# uses WEB_CONSOLE_PORT from `~/yos/.env` and connects on localhost.
# YOS_WEB_CONSOLE_URL=http://127.0.0.1:3457
# YOS_WEB_PASSWORD=configure-server-side-only
YOS_POLL_INTERVAL_MS=500
YOS_RESPONSE_TIMEOUT_MS=180000

# External Agent Gateway bridge. Create the Agent in /settings/agents, then
# place its one-time credential in .env.local or the process environment.
YOYOO_GATEWAY_URL=http://127.0.0.1:4175
# YOYOO_AGENT_TOKEN=yya_replace_with_the_one_time_agent_credential

# AI Card Agent runtime bridge. Keep the PKCS#8 PEM file owner-readable only
# (`chmod 600`) and never paste the private key into an environment variable.
# Preferred: use the protected JSON created by AI Card's enrollment client.
# AICARD_NODE_CREDENTIAL_FILE=/absolute/private/path/node-credential.json
# Compatibility: a separate node UUID and PKCS#8 PEM private-key file.
# AICARD_NODE_ID=replace_with_claimed_node_uuid
# AICARD_NODE_PRIVATE_KEY_FILE=/absolute/private/path/node-private-key.pem

# Real YOS validation is opt-in because it sends one message to YOS.
# YOS_GATEWAY_LIVE_TEST=1
